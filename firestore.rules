rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.username.matches('^[a-zA-Z0-9_.-]+$') &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
             data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
             data.passwordHash is string && data.passwordHash.size() >= 32 && data.passwordHash.size() <= 256 &&
             data.passwordHash.matches('^pbkdf2_sha256\\$[0-9]+\\$[A-Za-z0-9+/=]+\\$[A-Za-z0-9+/=]+$') &&
             (!('profilePictureUrl' in data) || (
               data.profilePictureUrl is string &&
               data.profilePictureUrl.size() <= 500 &&
               (data.profilePictureUrl.size() == 0 || data.profilePictureUrl.matches('^https://.*'))
             ));
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.type in ['income', 'expense'] &&
             data.amount is number && data.amount > 0 && data.amount <= 1000000000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.note is string && data.note.size() <= 200 &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.account in ['cash', 'bank'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'email', 'passwordHash', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'email', 'passwordHash', 'profilePictureUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['username', 'email', 'passwordHash', 'profilePictureUrl', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'type', 'amount', 'category', 'note', 'date', 'account', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'type', 'amount', 'category', 'note', 'date', 'account', 'createdAt', 'updatedAt']) &&
                         isValidTransaction(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time;

        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'note', 'date', 'account', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(transactionId);
      }
    }
  }
}
